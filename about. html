  <main class="about-page">

    <div class="about-container">


      <!-- HERO -->

      <section class="about-hero">

        <div>

          <div class="about-badge">
            🩸 Healthcare Coordination Network
          </div>

          <h1>
            Care that
            <span>connects.</span>
          </h1>

          <p>
            PRANAV is designed as a patient-centric healthcare coordination
            layer that brings emergency requirements, potential blood
            resources, donor networks and authorised healthcare facilities
            into one structured journey.
          </p>

          <div class="hero-actions">

            <a
              href="emergency.html"
              class="primary-action"
            >
              🚨 Create Emergency Request
            </a>

            <a
              href="assistant.html"
              class="secondary-action"
            >
              🤖 Meet PRANAV AI
            </a>

          </div>

        </div>


        <!-- NETWORK VISUAL -->

        <div class="network-visual">

          <div class="network-ring"></div>

          <div class="network-ring two"></div>

          <div class="network-core">

            <div class="drop">
              🩸
            </div>

            <strong>
              PRANAV
            </strong>

          </div>

          <div class="network-node node-1">
            🏥
          </div>

          <div class="network-node node-2">
            📍
          </div>

          <div class="network-node node-3">
            👥
          </div>

          <div class="network-node node-4">
            🤖
          </div>

        </div>

      </section>


      <!-- MISSION -->

      <section class="mission-section">

        <div class="section-heading">

          <span>
            OUR PURPOSE
          </span>

          <h2>
            Built around the patient's journey
          </h2>

          <p>
            Emergency healthcare coordination can involve multiple people,
            facilities and information sources. PRANAV brings these steps
            together into a clearer digital experience.
          </p>

        </div>


        <div class="mission-grid">

          <article class="mission-card">

            <div class="mission-icon">
              🚨
            </div>

            <h3>
              Emergency First
            </h3>

            <p>
              Create structured emergency requests with the key information
              needed for coordination.
            </p>

          </article>


          <article class="mission-card">

            <div class="mission-icon">
              🧠
            </div>

            <h3>
              Intelligent Coordination
            </h3>

            <p>
              Organise requirements and discover potential resources using
              factors such as component, location and urgency.
            </p>

          </article>


          <article class="mission-card">

            <div class="mission-icon">
              🤝
            </div>

            <h3>
              Connected Care
            </h3>

            <p>
              Help patients, donors and authorised healthcare facilities
              coordinate through a transparent workflow.
            </p>

          </article>

        </div>

      </section>


      <!-- JOURNEY -->

      <section class="journey-section">

        <div class="section-heading">

          <span>
            PRANAV JOURNEY
          </span>

          <h2>
            From request to resolution
          </h2>

          <p>
            A structured coordination flow designed to reduce confusion
            during time-sensitive situations.
          </p>

        </div>


        <div class="journey">

          <div class="journey-step">

            <div class="journey-circle">
              🚨
            </div>

            <strong>
              Emergency<br />
              Request
            </strong>

          </div>


          <div class="journey-arrow">
            →
          </div>


          <div class="journey-step">

            <div class="journey-circle">
              🧠
            </div>

            <strong>
              Requirement<br />
              Analysis
            </strong>

          </div>


          <div class="journey-arrow">
            →
          </div>


          <div class="journey-step">

            <div class="journey-circle">
              🔎
            </div>

            <strong>
              Potential<br />
              Matching
            </strong>

          </div>


          <div class="journey-arrow">
            →
          </div>


          <div class="journey-step">

            <div class="journey-circle">
              🛡️
            </div>

            <strong>
              Verification &<br />
              Coordination
            </strong>

          </div>


          <div class="journey-arrow">
            →
          </div>


          <div class="journey-step">

            <div class="journey-circle">
              ✅
            </div>

            <strong>
              Resolution /<br />
              Closure
            </strong>

          </div>

        </div>

      </section>


      <!-- PRINCIPLES -->

      <section class="principles-section">

        <div class="section-heading">

          <span>
            DESIGN PRINCIPLES
          </span>

          <h2>
            Technology with responsibility
          </h2>

          <p>
            PRANAV is designed to support healthcare coordination without
            replacing qualified professionals or authorised blood centres.
          </p>

        </div>


        <div class="principles-grid">

          <article class="principle-card">

            <div class="principle-number">
              01
            </div>

            <div>

              <h3>
                Patient-Centric
              </h3>

              <p>
                The experience starts with what the patient or attendant
                needs during an emergency.
              </p>

            </div>

          </article>


          <article class="principle-card">

            <div class="principle-number">
              02
            </div>

            <div>

              <h3>
                Verification First
              </h3>

              <p>
                Potential resources are clearly distinguished from
                verified availability.
              </p>

            </div>

          </article>


          <article class="principle-card">

            <div class="principle-number">
              03
            </div>

            <div>

              <h3>
                Privacy by Design
              </h3>

              <p>
                Sensitive donor information should not be exposed through
                a public directory.
              </p>

            </div>

          </article>


          <article class="principle-card">

            <div class="principle-number">
              04
            </div>

            <div>

              <h3>
                Accessible by Default
              </h3>

              <p>
                Simple language, Easy Mode, large actions and voice-friendly
                interactions support different user needs.
              </p>

            </div>

          </article>


          <article class="principle-card">

            <div class="principle-number">
              05
            </div>

            <div>

              <h3>
                AI as Assistance
              </h3>

              <p>
                PRANAV AI can help users navigate information and workflows,
                but does not independently diagnose or prescribe.
              </p>

            </div>

          </article>


          <article class="principle-card">

            <div class="principle-number">
              06
            </div>

            <div>

              <h3>
                Human-in-the-Loop
              </h3>

              <p>
                Verification, clinical decisions, blood compatibility,
                release and transfusion remain with authorised professionals.
              </p>

            </div>

          </article>

        </div>

      </section>


      <!-- SAFETY -->

      <section class="safety-section">

        <div class="safety-card">

          <h2>
            🛡️ What PRANAV does — and does not do
          </h2>

          <p>
            PRANAV is a coordination and decision-support platform.
            Actual blood collection, testing, storage, compatibility,
            release and transfusion remain with authorised blood centres
            and healthcare professionals.
          </p>


          <div class="safety-list">

            <div class="safety-item">

              <strong>
                ✓ Coordinates
              </strong>

              <span>
                Emergency requests, potential resources, donors and
                healthcare facilities.
              </span>

            </div>


            <div class="safety-item">

              <strong>
                ✓ Supports
              </strong>

              <span>
                Search, tracking, navigation, communication and
                decision-support analytics.
              </span>

            </div>


            <div class="safety-item">

              <strong>
                ✓ Verifies
              </strong>

              <span>
                Encourages confirmation with authorised facilities before
                relying on resource information.
              </span>

            </div>


            <div class="safety-item">

              <strong>
                ✕ No Guarantee
              </strong>

              <span>
                A potential match never means guaranteed blood availability.
              </span>

            </div>


            <div class="safety-item">

              <strong>
                ✕ No Blood Storage
              </strong>

              <span>
                PRANAV does not itself collect, test or store blood.
              </span>

            </div>


            <div class="safety-item">

              <strong>
                ✕ No Autonomous Prescription
              </strong>

              <span>
                Medication decisions and dosage remain with qualified
                healthcare professionals.
              </span>

            </div>

          </div>

        </div>

      </section>


      <!-- CTA -->

      <section class="about-cta">

        <h2>
          Ready to explore PRANAV?
        </h2>

        <p>
          Start an emergency request, discover potential blood resources,
          explore healthcare education or talk to the PRANAV AI Assistant.
        </p>


        <div class="about-cta-actions">

          <a
            href="emergency.html"
            class="primary-action"
          >
            🚨 Emergency Request
          </a>

          <a
            href="find-blood.html"
            class="secondary-action"
          >
            🔎 Find Blood
          </a>

          <a
            href="assistant.html"
            class="secondary-action"
          >
            🤖 Ask PRANAV
          </a>

        </div>

      </section>


      <div class="footer-note">

        PRANAV — Connecting People. Supporting Care.

      </div>

    </div>

