<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>About PRANAV | Connecting People. Supporting Care.</title>

  <meta
    name="description"
    content="Learn about PRANAV, an intelligent healthcare coordination platform designed to connect emergency requirements, potential blood resources, donor networks and authorised healthcare facilities."
  />

  <link rel="icon" href="pranav-logo.png" />
  <link rel="manifest" href="manifest.json" />

  <link rel="stylesheet" href="css/style.css" />
  <link rel="stylesheet" href="css/responsive.css" />
  <link rel="stylesheet" href="css/animations.css" />

  <style>
    .about-page {
      min-height: 100vh;
      padding: 55px 20px 110px;

      background:
        radial-gradient(
          circle at 10% 10%,
          rgba(207, 248, 229, 0.75),
          transparent 32%
        ),
        radial-gradient(
          circle at 90% 15%,
          rgba(255, 220, 226, 0.7),
          transparent 34%
        ),
        linear-gradient(135deg, #f8fffc, #fff8f9);

      color: #26302e;
    }

    .about-container {
      width: min(1180px, 100%);
      margin: auto;
    }

    /* HERO */

    .about-hero {
      display: grid;
      grid-template-columns: 1.15fr .85fr;
      gap: 50px;
      align-items: center;
      margin-bottom: 65px;
    }

    .about-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      padding: 9px 15px;
      margin-bottom: 18px;

      border-radius: 50px;

      background: rgba(255,255,255,.78);
      border: 1px solid rgba(165,30,54,.12);

      color: #a51e36;
      font-size: 13px;
      font-weight: 800;
    }

    .about-hero h1 {
      margin: 0;

      font-size: clamp(38px, 5.5vw, 68px);
      line-height: 1.02;
      letter-spacing: -1.8px;
    }

    .about-hero h1 span {
      color: #a51e36;
    }

    .about-hero p {
      max-width: 690px;

      margin: 20px 0 0;

      color: #66736f;
      font-size: 17px;
      line-height: 1.75;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .primary-action,
    .secondary-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      padding: 14px 20px;

      border-radius: 14px;

      text-decoration: none;
      font-weight: 800;

      transition: .25s ease;
    }

    .primary-action {
      background: #a51e36;
      color: white;
      box-shadow: 0 12px 25px rgba(165,30,54,.16);
    }

    .secondary-action {
      background: rgba(255,255,255,.8);
      color: #36413e;
      border: 1px solid #dfe9e4;
    }

    .primary-action:hover,
    .secondary-action:hover {
      transform: translateY(-2px);
    }

    /* NETWORK VISUAL */

    .network-visual {
      min-height: 370px;

      position: relative;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 35px;

      background:
        linear-gradient(
          145deg,
          rgba(255,255,255,.84),
          rgba(236,250,244,.72)
        );

      border: 1px solid rgba(55,90,75,.1);

      box-shadow: 0 25px 70px rgba(35,65,53,.10);

      overflow: hidden;
    }

    .network-ring {
      position: absolute;

      width: 285px;
      height: 285px;

      border: 1px dashed rgba(165,30,54,.22);
      border-radius: 50%;

      animation: rotateRing 20s linear infinite;
    }

    .network-ring.two {
      width: 190px;
      height: 190px;

      border-color: rgba(45,130,92,.2);

      animation-direction: reverse;
      animation-duration: 14s;
    }

    .network-core {
      position: relative;
      z-index: 3;

      width: 105px;
      height: 105px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background:
        linear-gradient(
          145deg,
          #ffffff,
          #effaf5
        );

      border: 2px solid rgba(165,30,54,.16);

      box-shadow:
        0 0 0 15px rgba(255,255,255,.4),
        0 20px 40px rgba(45,70,60,.12);

      text-align: center;
    }

    .network-core .drop {
      font-size: 34px;
      line-height: 1;
    }

    .network-core strong {
      margin-top: 5px;
      font-size: 13px;
      color: #a51e36;
    }

    .network-node {
      position: absolute;
      z-index: 4;

      width: 62px;
      height: 62px;

      display: grid;
      place-items: center;

      border-radius: 18px;

      background: rgba(255,255,255,.92);

      border: 1px solid #e1ebe6;

      box-shadow: 0 10px 30px rgba(35,60,50,.1);

      font-size: 25px;
    }

    .node-1 {
      top: 50px;
      left: 50%;
      transform: translateX(-50%);
    }

    .node-2 {
      right: 42px;
      top: 50%;
      transform: translateY(-50%);
    }

    .node-3 {
      bottom: 48px;
      left: 50%;
      transform: translateX(-50%);
    }

    .node-4 {
      left: 42px;
      top: 50%;
      transform: translateY(-50%);
    }

    @keyframes rotateRing {
      from {
        transform: rotate(0);
      }

      to {
        transform: rotate(360deg);
      }
    }

    /* SECTION */

    .section-heading {
      text-align: center;
      max-width: 750px;
      margin: 0 auto 35px;
    }

    .section-heading span {
      display: inline-block;

      margin-bottom: 9px;

      color: #a51e36;

      font-size: 12px;
      font-weight: 900;

      letter-spacing: 1.4px;
      text-transform: uppercase;
    }

    .section-heading h2 {
      margin: 0;

      font-size: clamp(28px, 4vw, 42px);
      line-height: 1.15;
    }

    .section-heading p {
      margin: 13px auto 0;

      color: #72807b;
      line-height: 1.65;
    }

    /* MISSION */

    .mission-section {
      margin-bottom: 70px;
    }

    .mission-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .mission-card {
      padding: 28px;

      border-radius: 24px;

      background: rgba(255,255,255,.83);

      border: 1px solid rgba(50,85,70,.1);

      box-shadow: 0 15px 45px rgba(30,55,45,.07);

      transition: .25s ease;
    }

    .mission-card:hover {
      transform: translateY(-5px);
    }

    .mission-icon {
      width: 52px;
      height: 52px;

      display: grid;
      place-items: center;

      margin-bottom: 18px;

      border-radius: 16px;

      background: #f0faf5;

      font-size: 25px;
    }

    .mission-card h3 {
      margin: 0 0 9px;

      font-size: 19px;
    }

    .mission-card p {
      margin: 0;

      color: #707d79;
      line-height: 1.65;
      font-size: 14px;
    }

    /* JOURNEY */

    .journey-section {
      margin-bottom: 70px;
    }

    .journey {
      display: grid;

      grid-template-columns: repeat(8, 1fr);

      gap: 8px;

      align-items: center;
    }

    .journey-step {
      text-align: center;
    }

    .journey-circle {
      width: 58px;
      height: 58px;

      margin: auto;

      display: grid;
      place-items: center;

      border-radius: 50%;

      background: white;

      border: 2px solid #dceae4;

      box-shadow: 0 10px 25px rgba(30,60,50,.07);

      font-size: 21px;
    }

    .journey-step strong {
      display: block;

      margin-top: 9px;

      font-size: 11px;
      line-height: 1.35;

      color: #52615c;
    }

    .journey-arrow {
      text-align: center;

      color: #a51e36;
      font-weight: 900;
    }

    /* PRINCIPLES */

    .principles-section {
      margin-bottom: 70px;
    }

    .principles-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .principle-card {
      display: flex;
      gap: 17px;

      padding: 22px;

      border-radius: 20px;

      background: rgba(255,255,255,.78);

      border: 1px solid #e1ebe6;
    }

    .principle-number {
      width: 38px;
      height: 38px;

      flex-shrink: 0;

      display: grid;
      place-items: center;

      border-radius: 12px;

      background: #a51e36;
      color: white;

      font-size: 13px;
      font-weight: 900;
    }

    .principle-card h3 {
      margin: 0 0 6px;
      font-size: 16px;
    }

    .principle-card p {
      margin: 0;

      color: #74807d;
      font-size: 13px;
      line-height: 1.6;
    }

    /* SAFETY */

    .safety-section {
      margin-bottom: 70px;
    }

    .safety-card {
      padding: 30px;

      border-radius: 27px;

      background:
        linear-gradient(
          135deg,
          rgba(255,244,246,.92),
          rgba(255,255,255,.9)
        );

      border: 1px solid #f0d9dd;

      box-shadow: 0 18px 45px rgba(90,35,45,.07);
    }

    .safety-card h2 {
      margin: 0 0 12px;

      color: #8e1b30;
      font-size: 25px;
    }

    .safety-card > p {
      margin: 0 0 20px;

      color: #6f6265;
      line-height: 1.7;
    }

    .safety-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .safety-item {
      padding: 17px;

      border-radius: 16px;

      background: rgba(255,255,255,.7);

      border: 1px solid #f0dfe2;
    }

    .safety-item strong {
      display: block;

      margin-bottom: 5px;

      color: #34302f;
      font-size: 14px;
    }

    .safety-item span {
      color: #796f71;
      font-size: 12px;
      line-height: 1.5;
    }

    /* CTA */

    .about-cta {
      padding: 45px 30px;

      text-align: center;

      border-radius: 30px;

      background:
        linear-gradient(
          135deg,
          #ffffff,
          #eefaf5
        );

      border: 1px solid #dceae4;

      box-shadow: 0 20px 55px rgba(30,65,50,.08);
    }

    .about-cta h2 {
      margin: 0;

      font-size: clamp(28px, 4vw, 40px);
    }

    .about-cta p {
      max-width: 650px;

      margin: 13px auto 23px;

      color: #71807b;
      line-height: 1.65;
    }

    .about-cta-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .footer-note {
      text-align: center;

      margin-top: 25px;

      color: #8b9692;
      font-size: 12px;
    }

    /* RESPONSIVE */

    @media (max-width: 950px) {

      .about-hero {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .network-visual {
        min-height: 320px;
      }

      .mission-grid {
        grid-template-columns: 1fr;
      }

      .journey {
        grid-template-columns: repeat(4, 1fr);
        row-gap: 25px;
      }

      .journey-arrow {
        display: none;
      }

      .safety-list {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {

      .about-page {
        padding: 35px 14px 105px;
      }

      .about-hero h1 {
        letter-spacing: -1px;
      }

      .about-hero p {
        font-size: 15px;
      }

      .network-visual {
        min-height: 285px;
      }

      .network-ring {
        width: 220px;
        height: 220px;
      }

      .network-ring.two {
        width: 145px;
        height: 145px;
      }

      .network-node {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        font-size: 21px;
      }

      .node-2 {
        right: 22px;
      }

      .node-4 {
        left: 22px;
      }

      .journey {
        grid-template-columns: repeat(2, 1fr);
      }

      .principles-grid {
        grid-template-columns: 1fr;
      }

      .hero-actions a {
        width: 100%;
      }

      .about-cta {
        padding: 35px 20px;
      }
    }
  </style>
</head>

